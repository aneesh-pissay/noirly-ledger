# Noirly Ledger
NEXT_PUBLIC_APP_URL=http://localhost:3003
AUTH_URL=http://localhost:3003
AUTH_SECRET=replace-with-at-least-32-chars-of-random-data
AUTH_TRUST_HOST=true

# Same Mongo host as Identity; different database name
MONGODB_URI=mongodb://127.0.0.1:27017/noirly-ledger

# Noirly Identity OIDC — register a real client (not db:seed):
#   cd ../noirly-identity
#   npm run client:register -- --client-id=noirly-ledger --name=NoirlyLedger --redirect-uri=http://localhost:3003/api/auth/callback/noirly
AUTH_NOIRLY_ISSUER=http://localhost:3000
AUTH_NOIRLY_CLIENT_ID=noirly-ledger
AUTH_NOIRLY_CLIENT_SECRET=

# Public Identity URL for Google One Tap (production: https://noirly.identity.aneesh-pissay.in)
NEXT_PUBLIC_IDENTITY_URL=http://localhost:3000

# noirly-realtime (optional in Phase 0)
REALTIME_JWT_SECRET=dev-noirly-realtime-jwt-secret-change-me-32
REALTIME_JWT_ISSUER=noirly-ledger
REALTIME_JWT_AUDIENCE=noirly-realtime
REALTIME_INTERNAL_URL=http://127.0.0.1:4001
REALTIME_INTERNAL_SECRET=dev-noirly-realtime-jwt-secret-change-me-32
NEXT_PUBLIC_REALTIME_WS_URL=ws://127.0.0.1:4001/ws

# Recurring engine (POST /api/cron/recurring)
CRON_SECRET=

# Noirly Flow, for bills and reminders as Flow tasks (Settings → Noirly Flow); unset hides it
# NOIRLY_FLOW_URL=http://localhost:3002
# Seals transaction and bill notes, account numbers and Flow tokens, and keys note search.
# Falls back to AUTH_SECRET. Set it in production and never change it: what's sealed under
# the old key can't be read with a new one. Back it up with the database.
# LEDGER_SECRET_KEY=replace-with-at-least-32-chars-of-random-data

# Emailed receipts and bills (docs/INBOUND-EMAIL.md): the domain workspace addresses are at,
# and the secret the relay sends as a Bearer token to POST /api/inbound-email. Unset hides it.
# INBOUND_EMAIL_DOMAIN=in.ledger.example.com
# INBOUND_EMAIL_SECRET=replace-with-at-least-32-chars-of-random-data

# Webhooks (docs/API.md) go to public https URLs only; "1" also allows http://localhost, for local development.
# LEDGER_WEBHOOKS_ALLOW_LOCALHOST=1

# Optional email for in-app notification kinds
# SMTP_URL=smtp://user:pass@localhost:1025
# SMTP_FROM=Noirly Ledger <noreply@localhost>


# Cloudflare R2 (receipt uploads; falls back to data/receipts when unset)
# R2_BUCKET_NAME=noirly-ledger
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
